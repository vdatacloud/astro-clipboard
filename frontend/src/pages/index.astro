---
import logo from '../assets/datacloud-logo.svg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Clipped Image Upload and Markup</title>
		<meta name="description" content="Paste a screenshot and pin requirements onto it. A demo by Data Cloud LLC." />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} sizes="any" />
		<!-- is:global: .req-item and .dropped-badge are created by script, so Astro's scoped styles would not reach them -->
		<style is:global>
			/* Data Cloud brand tokens, copied from @vdatacloud/cx-commons (src/styles/global.css).
			   That package's CSS starts with Tailwind's reset, which would restyle this page, so it is not imported. */
			:root {
				--color-brand-50: #eff6ff;
				--color-brand-100: #d9eaff;
				--color-brand-500: #3a8eed; /* logo cloud */
				--color-brand-600: #1671ce; /* links/text on light bg, 4.9:1 on white */
				--color-brand-700: #005cb0;
				--color-leaf-500: #68bc36;  /* logo data */
				--color-slate-50: #f8fafc;
				--color-slate-100: #f1f5f9;
				--color-slate-200: #e2e8f0;
				--color-slate-300: #cbd5e1;
				--color-slate-500: #64748b;
				--color-slate-600: #475569;
				--color-slate-800: #1e293b;
				--color-slate-900: #0f172a;
				--color-critical: var(--color-critical);
			}
			@font-face {
				font-family: 'Plus Jakarta Sans';
				font-style: normal;
				font-weight: 300 800;
				font-display: swap;
				src: url('../assets/plus-jakarta-sans-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			body {
				font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				margin: 0;
				padding: 0;
				display: flex;
				height: 100vh;
				background-color: var(--color-slate-100);
			}
			/* Sidebar Left Pane */
			.left-pane {
				width: 320px;
				background: white;
				border-right: 1px solid var(--color-slate-200);
				padding: 20px;
				box-sizing: border-box;
				overflow-y: auto;
				z-index: 10;
				display: flex;
				flex-direction: column;
			}
			.app-header {
				display: flex;
				align-items: center;
				gap: 12px;
				margin-bottom: 20px;
			}
			.app-header img {
				width: 44px;
				height: auto;
				flex: none;
			}
			.left-pane h1 {
				margin: 0;
				font-size: 1.25rem;
				font-weight: 800;
				line-height: 1.25;
				color: var(--color-slate-900);
			}
			.app-footer {
				margin-top: auto;
				padding-top: 16px;
				border-top: 1px solid var(--color-slate-200);
				font-size: 0.8rem;
				color: var(--color-slate-500);
				line-height: 1.6;
			}
			.app-footer a {
				color: var(--color-brand-700);
				text-decoration: none;
			}
			.app-footer a:hover {
				text-decoration: underline;
			}
			.app-footer svg {
				vertical-align: -2px;
				margin-right: 4px;
			}
			.left-pane h2 {
				margin-top: 0;
				font-size: 1.2rem;
				color: var(--color-slate-800);
				border-bottom: 2px solid var(--color-brand-600);
				padding-bottom: 8px;
			}
			.req-item {
				background: var(--color-slate-50);
				border: 1px solid var(--color-slate-300);
				border-radius: 6px;
				padding: 12px;
				margin-bottom: 12px;
				cursor: grab;
				user-select: none;
				transition: background 0.2s;
			}
			.req-item:hover {
				background: var(--color-brand-50);
				border-color: var(--color-brand-600);
			}
			/* Main Content Window */
			.main-content {
				flex: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 40px;
				box-sizing: border-box;
				overflow: auto;
			}
			/* Empty state styling */
			.empty-state {
				width: 100%;
				max-width: 600px;
				height: 400px;
				border: 2px dashed var(--color-slate-300);
				border-radius: 8px;
				display: flex;
				align-items: center;
				justify-content: center;
				background: white;
				color: var(--color-slate-600);
				text-align: center;
				padding: 20px;
				box-sizing: border-box;
			}
			.empty-state:focus {
				outline: none;
				border-color: var(--color-brand-600);
				background-color: var(--color-brand-50);
			}
			/* Tight canvas wrapper matching image dimensions exactly */
			/* Image on the left, a right margin column (padding-right) for the requirement cards */
			#drop-zone-wrapper {
				position: relative;
				display: inline-block;
				padding-right: 240px; /* MARGIN_GAP + BADGE_WIDTH in the script */
			}
			#preview {
				display: block;
				box-shadow: 0 4px 20px rgba(0,0,0,0.15);
				background: white;
				max-width: calc(100vw - 320px - 80px - 240px); /* minus sidebar, page padding, card column */
				max-height: 70vh;
				height: auto;
				width: auto;
				border-radius: 4px;
			}
			/* Overlay SVG layers strictly inside wrapper context */
			#overlay-canvas {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 5;
			}
			/* Requirement card in the right margin column */
			.dropped-badge {
				position: absolute;
				padding: 6px 12px;
				color: white;
				font-size: 13px;
				font-weight: 500;
				border-radius: 6px;
				white-space: normal;
				box-sizing: border-box;
				pointer-events: none;
				box-shadow: 0 4px 10px rgba(0,0,0,0.25);
				z-index: 6;
				line-height: 1.3;
			}
			/* Upload Action Footer */
			.actions {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 10px;
				margin-top: 25px;
			}
			button {
				padding: 10px 24px;
				font-size: 16px;
				background-color: var(--color-brand-600);
				color: white;
				border: none;
				border-radius: 6px;
				cursor: pointer;
				font-weight: 500;
			}
			button.icon-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 44px;
				height: 44px;
				padding: 0;
			}
			button.secondary {
				background-color: white;
				color: var(--color-brand-600);
				border: 1px solid var(--color-brand-600);
			}
			#status-msg {
				flex-basis: 100%;
				margin: 10px 0 0;
				min-height: 1.2em;
				font-size: 14px;
				color: var(--color-slate-600);
				text-align: center;
			}
			#status-msg.error {
				color: var(--color-critical);
			}
			button.secondary:disabled {
				border-color: var(--color-slate-300);
			}
			button:disabled {
				background-color: var(--color-slate-300);
				cursor: not-allowed;
			}
		</style>
	</head>
	<body>

		<!-- Left Sidebar: Requirements List -->
		<div class="left-pane">
			<header class="app-header">
				<a href="https://vdatacloud.com" target="_blank" rel="noopener"><img src={logo.src} alt="Data Cloud" width="44" height="35" /></a>
				<h1>Clipped Image Upload and Markup</h1>
			</header>
			<h2>System Requirements</h2>
			<div id="requirements-list">Loading requirements from server...</div>
			<footer class="app-footer">
				<div>Built by <a href="https://vdatacloud.com" target="_blank" rel="noopener">Data Cloud LLC</a></div>
				<div>
					<a href="https://github.com/vdatacloud/astro-clipboard" target="_blank" rel="noopener"><svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>Source on GitHub</a>
				</div>
			</footer>
		</div>

		<!-- Right Side Canvas: Upload and Interaction -->
		<div class="main-content">
			
			<div id="empty-state-prompt" class="empty-state" tabindex="0">
				<p>Click here and press Ctrl+V (or Cmd+V) to paste a screenshot,<br />or use the upload button to choose a PNG or GIF.</p>
			</div>

			<div id="drop-zone-wrapper" style="display: none;">
				<img id="preview" alt="Screenshot preview" />
				<svg id="overlay-canvas"></svg>
			</div>
			
			<div class="actions">
				<input id="file-input" type="file" accept="image/png,image/gif" hidden />
				<button id="upload-btn" class="icon-btn" title="Upload image (PNG or GIF)" aria-label="Upload image">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
				</button>
				<button id="refresh-btn" class="icon-btn secondary" title="Refresh (clears image and mappings)" aria-label="Refresh">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
				</button>
				<button id="save-draft-btn" class="icon-btn secondary" title="Save draft" aria-label="Save draft" disabled>
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
				</button>
				<button id="save-btn" class="icon-btn" title="Save (all requirements mapped)" aria-label="Save" disabled>
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
				</button>
				<p id="status-msg" role="status"></p>
			</div>
		</div>

		<script>
			type Requirement = { id: number; text: string };
			type Pin = {
				id: number;
				text: string;
				color: string;
				pctX: number; // 0..1 of displayed image width
				pctY: number; // 0..1 of displayed image height
				x: number;    // pixel x in the original (natural) image
				y: number;    // pixel y in the original (natural) image
			};

			// The Go server locally; the demo build sets PUBLIC_API_BASE to the Worker's path on vdatacloud.com.
			const API_BASE = import.meta.env.PUBLIC_API_BASE ?? 'http://localhost:8080';
			const BADGE_WIDTH = 200;  // keep in sync with the wrapper's padding-right in CSS
			const MARGIN_GAP = 40;    // space between the image's right edge and the cards
			const CARD_SPACING = 8;   // vertical gap between stacked cards
			const PIN_RADIUS = 8;

			const emptyStatePrompt = document.getElementById('empty-state-prompt') as HTMLDivElement;
			const dropZoneWrapper = document.getElementById('drop-zone-wrapper') as HTMLDivElement;
			const preview = document.getElementById('preview') as HTMLImageElement;
			const uploadBtn = document.getElementById('upload-btn') as HTMLButtonElement;
			const refreshBtn = document.getElementById('refresh-btn') as HTMLButtonElement;
			const saveDraftBtn = document.getElementById('save-draft-btn') as HTMLButtonElement;
			const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
			const statusMsg = document.getElementById('status-msg') as HTMLParagraphElement;
			const reqListContainer = document.getElementById('requirements-list') as HTMLDivElement;
			const svgCanvas = document.getElementById('overlay-canvas') as unknown as SVGSVGElement;

			let targetFile: File | null = null;
			let previewUrl: string | null = null;
			const colors = ['#e6194B', '#3cb44b', '#1d4ed8', '#f58231', '#911eb4', '#42d4f4', '#b5179e', '#00f5d4'];
			let pinnedRequirements: Pin[] = [];
			let requirements: Requirement[] = [];
			let busy = false;

			// 1. Fetch requirements dynamically from Go server
			async function loadRequirements() {
				try {
					const res = await fetch(`${API_BASE}/api/requirements`);
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const data: Requirement[] = await res.json();
					requirements = data;

					reqListContainer.innerHTML = '';
					data.forEach((req, idx) => {
						const div = document.createElement('div');
						div.className = 'req-item';
						div.style.borderLeft = '4px solid var(--color-slate-300)';
						div.style.transition = 'all 0.2s ease';
						div.draggable = true;
						div.innerText = `${req.id}) ${req.text}`;
						div.id = `sidebar-req-${req.id}`;
						div.dataset.id = String(req.id);

						div.addEventListener('dragstart', (e) => {
							if (!e.dataTransfer) return;
							e.dataTransfer.effectAllowed = 'copy';
							e.dataTransfer.setData('text/plain', JSON.stringify({
								id: req.id,
								text: req.text,
								color: colors[idx % colors.length]
							}));
						});
						reqListContainer.appendChild(div);
					});
				} catch (err) {
					console.error('Failed to load requirements:', err);
					requirements = [];
					reqListContainer.innerText = 'Failed to load requirements from backend.';
				}
				renderAllPins();
			}

			// 2. Clipboard Paste Handler
			// Listen on the document: the image wrapper is not focusable, so a listener on it
			// never fires and a second screenshot could not replace the first.
			function handlePaste(event: ClipboardEvent) {
				const items = event.clipboardData?.items;
				if (!items) return;
				for (const item of items) {
					if (!item.type.startsWith('image/')) continue;
					const blob = item.getAsFile();
					if (!blob) continue;
					event.preventDefault();

					loadImage(new File([blob], `screenshot-${Date.now()}.png`, { type: blob.type }));
					break;
				}
			}

			document.addEventListener('paste', handlePaste);

			// Shows a pasted or chosen image and starts a fresh mapping on it.
			function loadImage(file: File) {
				targetFile = file;
				if (previewUrl) URL.revokeObjectURL(previewUrl);
				previewUrl = URL.createObjectURL(file);

				preview.onload = () => {
					emptyStatePrompt.style.display = 'none';
					dropZoneWrapper.style.display = 'inline-block';
					setStatus('');
					clearPins();
				};
				preview.onerror = () => setStatus('Could not read that image file.', true);
				preview.src = previewUrl;
			}

			// Upload button: pick a PNG or GIF from the local filesystem.
			const ALLOWED_TYPES: Record<string, string> = { 'image/png': 'png', 'image/gif': 'gif' };
			const fileInput = document.getElementById('file-input') as HTMLInputElement;
			uploadBtn.addEventListener('click', () => fileInput.click());
			fileInput.addEventListener('change', () => {
				const file = fileInput.files?.[0];
				fileInput.value = ''; // allow choosing the same file again
				if (!file) return;
				const ext = ALLOWED_TYPES[file.type];
				if (!ext) {
					setStatus('Only PNG or GIF images are supported.', true);
					return;
				}
				// Timestamped name, like pasted screenshots, so saves never overwrite each other.
				loadImage(new File([file], `image-${Date.now()}.${ext}`, { type: file.type }));
			});

			function clearPins() {
				pinnedRequirements = [];
				renderAllPins();
			}

			// 3. Drop Zone Target Handlers
			dropZoneWrapper.addEventListener('dragover', (e) => {
				if (!targetFile) return;
				e.preventDefault();
				if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
			});

			dropZoneWrapper.addEventListener('drop', (e) => {
				e.preventDefault();
				if (!targetFile || !e.dataTransfer) return;

				try {
					const rawData = e.dataTransfer.getData('text/plain');
					if (!rawData) return;
					const data = JSON.parse(rawData) as { id: number; text: string; color: string };

					// Measure against the image itself, and clamp so a drop can never land outside it.
					const rect = preview.getBoundingClientRect();
					if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) return;
					const pctX = Math.min(Math.max((e.clientX - rect.left) / rect.width, 0), 1);
					const pctY = Math.min(Math.max((e.clientY - rect.top) / rect.height, 0), 1);

					const pin: Pin = {
						id: data.id,
						text: data.text,
						color: data.color,
						pctX,
						pctY,
						x: Math.round(pctX * preview.naturalWidth),
						y: Math.round(pctY * preview.naturalHeight)
					};

					// Re-dragging a requirement moves its pin rather than stacking a duplicate.
					const existing = pinnedRequirements.findIndex(p => p.id === data.id);
					if (existing >= 0) pinnedRequirements[existing] = pin;
					else pinnedRequirements.push(pin);
					setStatus('');

					renderAllPins();
				} catch (err) {
					console.error("Drop parsing error:", err);
				}
			});

			// 4. Rendering: positions are stored as fractions, so redraw from the current size.
			// Pins sit on the image; their requirement cards stack in the right margin column,
			// each joined to its pin by a leader line.
			function renderAllPins() {
				svgCanvas.innerHTML = '';
				document.querySelectorAll('.dropped-badge').forEach(b => b.remove());
				dropZoneWrapper.style.minHeight = '';
				highlightSidebar();
				updateButtons();

				if (!targetFile) return;
				const rect = preview.getBoundingClientRect();
				const svgNS = "http://www.w3.org/2000/svg";
				const cardLeft = rect.width + MARGIN_GAP;

				// Place cards top-down in pin order so they never overlap.
				const ordered = [...pinnedRequirements].sort((a, b) => a.pctY - b.pctY);
				let nextFreeTop = 0;
				let bottom = rect.height;

				ordered.forEach(pin => {
					const dropX = pin.pctX * rect.width;
					const dropY = pin.pctY * rect.height;

					const badge = document.createElement('div');
					badge.className = 'dropped-badge';
					badge.style.left = cardLeft + 'px';
					badge.style.width = BADGE_WIDTH + 'px';
					badge.style.backgroundColor = pin.color;
					badge.innerText = pin.text;
					badge.title = `Requirement ${pin.id} @ (${pin.x}, ${pin.y}) px`;
					dropZoneWrapper.appendChild(badge);

					// Center the card on the pin's height unless that would overlap the card above.
					const height = badge.offsetHeight;
					const top = Math.max(dropY - height / 2, nextFreeTop);
					badge.style.top = top + 'px';
					nextFreeTop = top + height + CARD_SPACING;
					bottom = Math.max(bottom, top + height);
					const cardMidY = top + height / 2;

					// Leader line from the edge of the pin to the card's left edge.
					const angle = Math.atan2(cardMidY - dropY, cardLeft - dropX);
					const line = document.createElementNS(svgNS, 'line');
					line.setAttribute('x1', String(dropX + Math.cos(angle) * PIN_RADIUS));
					line.setAttribute('y1', String(dropY + Math.sin(angle) * PIN_RADIUS));
					line.setAttribute('x2', String(cardLeft));
					line.setAttribute('y2', String(cardMidY));
					line.setAttribute('stroke', pin.color);
					line.setAttribute('stroke-width', '1.5');
					line.setAttribute('stroke-dasharray', '4,3');
					svgCanvas.appendChild(line);

					const circle = document.createElementNS(svgNS, 'circle');
					circle.setAttribute('cx', String(dropX));
					circle.setAttribute('cy', String(dropY));
					circle.setAttribute('r', String(PIN_RADIUS));
					circle.setAttribute('fill', pin.color);
					circle.setAttribute('stroke', '#ffffff');
					circle.setAttribute('stroke-width', '1.5');
					svgCanvas.appendChild(circle);

					const textMarker = document.createElementNS(svgNS, 'text');
					textMarker.setAttribute('x', String(dropX));
					textMarker.setAttribute('y', String(dropY));
					textMarker.setAttribute('fill', '#ffffff');
					textMarker.setAttribute('font-size', '9px');
					textMarker.setAttribute('font-weight', 'bold');
					textMarker.setAttribute('text-anchor', 'middle');
					textMarker.setAttribute('dominant-baseline', 'central');
					textMarker.textContent = String(pin.id);
					svgCanvas.appendChild(textMarker);
				});

				// Grow the wrapper if the stacked cards run past the bottom of the image.
				if (bottom > rect.height) dropZoneWrapper.style.minHeight = bottom + 'px';
			}

			window.addEventListener('resize', renderAllPins);

			// Color the sidebar card of every requirement that has a pin.
			function highlightSidebar() {
				const colorById = new Map(pinnedRequirements.map(p => [p.id, p.color]));
				document.querySelectorAll<HTMLElement>('.req-item').forEach(item => {
					const color = colorById.get(Number(item.dataset.id));
					item.style.borderLeft = color ? `6px solid ${color}` : '4px solid var(--color-slate-300)';
					item.style.backgroundColor = color ? `${color}10` : 'var(--color-slate-50)';
				});
			}

			// Save Draft is offered until every requirement is mapped; then it is replaced by Save.
			function updateButtons() {
				const allMapped = requirements.length > 0 &&
					requirements.every(r => pinnedRequirements.some(p => p.id === r.id));
				uploadBtn.disabled = busy;
				refreshBtn.disabled = busy;
				saveDraftBtn.hidden = allMapped;
				saveDraftBtn.disabled = busy || !targetFile;
				saveBtn.disabled = busy || !targetFile || !allMapped;
			}

			function setStatus(text: string, isError = false) {
				statusMsg.textContent = text;
				statusMsg.classList.toggle('error', isError);
			}

			// 5. Save Draft / Save: send the image plus the pin coordinates; the backend stores
			// the mapping next to the image with this status ("draft" or "final").
			async function submit(busyText: string, successText: string, status: 'draft' | 'final') {
				if (!targetFile || busy) return;
				const formData = new FormData();
				formData.append('image', targetFile);
				formData.append('pins', JSON.stringify(pinnedRequirements.map(({ id, text, x, y, pctX, pctY }) => ({
					id, text, x, y, pctX, pctY
				}))));
				formData.append('status', status);

				busy = true;
				setStatus(busyText);
				updateButtons();
				try {
					const response = await fetch(`${API_BASE}/api/upload`, {
						method: 'POST',
						body: formData
					});
					if (response.ok) setStatus(successText);
					else setStatus(`Failed (${response.status}): ${(await response.text()).trim()}`, true);
				} catch (error) {
					setStatus('Could not connect to backend server.', true);
				} finally {
					busy = false;
					updateButtons();
				}
			}

			saveDraftBtn.addEventListener('click', () => {
				const remaining = requirements.length - pinnedRequirements.length;
				submit('Saving draft...', `Draft saved (${remaining} requirement${remaining === 1 ? '' : 's'} still unmapped).`, 'draft');
			});
			saveBtn.addEventListener('click', () => submit('Saving...', 'Mapping saved.', 'final'));

			// Refresh starts over: drop the screenshot and every mapped requirement, then re-fetch requirements.
			refreshBtn.addEventListener('click', async () => {
				targetFile = null;
				if (previewUrl) URL.revokeObjectURL(previewUrl);
				previewUrl = null;
				preview.removeAttribute('src');
				dropZoneWrapper.style.display = 'none';
				emptyStatePrompt.style.display = '';
				clearPins();

				busy = true;
				setStatus('Refreshing...');
				updateButtons();
				await loadRequirements();
				busy = false;
				updateButtons();
				setStatus(requirements.length ? 'Cleared. Paste a new screenshot.' : 'Could not refresh requirements.', !requirements.length);
			});

			loadRequirements();
		</script>
	</body>
</html>